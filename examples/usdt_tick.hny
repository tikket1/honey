// usdt_tick.hny — fire on a USDT marker compiled into a user program.
//
// Applications like Python, PostgreSQL and node ship static markers
// (`provider:name`) at interesting points, recorded in the binary's ELF
// notes. A `usdt` probe attaches to one by name; the loader finds the
// marker's address in the notes and, if the program declared a semaphore,
// the kernel increments it so the program knows a probe is attached.
//
//   linux/honey-linux make -C linux usdt_demo          # the demo program
//   honeyc build examples/usdt_tick.hny -o build/usdt
//   linux/honey-linux ./linux/run.sh --json build/usdt.bin build/usdt.json
//   ... and in another shell in the environment: ./linux/usdt_demo

event Tick {
    pid: u32,
    comm: str<16>,
}

probe usdt("/work/linux/usdt_demo:honey:tick") {
    emit Tick { pid: pid(), comm: comm() };
}
