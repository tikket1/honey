#!/usr/bin/env bash
# Run a command inside the honey Linux environment (a privileged container on
# Docker Desktop's kernel), with the repo mounted at /work and tracefs +
# debugfs available so BPF programs can attach to tracepoints.
#
#   linux/honey-linux                 # interactive shell
#   linux/honey-linux make -C linux   # build the loader
#   linux/honey-linux ./linux/run.sh exec.bin exec.json
#
# Requires Docker Desktop running. Builds the image on first use.
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE=honey-linux:latest

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "building $IMAGE (first run only)..." >&2
    docker build -t "$IMAGE" "$REPO/linux"
fi

# Interactive only when we actually have a terminal (so scripts and CI work).
TTY_FLAGS="-i"
[ -t 0 ] && [ -t 1 ] && TTY_FLAGS="-it"

# One environment at a time: while a session is running (say `./honey run`
# in one terminal), a second call joins the same container, so a trigger
# command sees the same network namespace as the probe. HONEY_THEN is passed
# through for `./honey run --then`.
NAME=honey-env
if docker ps -q -f "name=^${NAME}$" | grep -q .; then
    exec docker exec $TTY_FLAGS -w /work -e "HONEY_THEN=${HONEY_THEN:-}" -e "HONEY_PREP=${HONEY_PREP:-}" "$NAME" "${@:-bash}"
fi

exec docker run --rm --name "$NAME" $TTY_FLAGS \
    --privileged \
    --pid=host \
    -e "HONEY_THEN=${HONEY_THEN:-}" -e "HONEY_PREP=${HONEY_PREP:-}" \
    -v "$REPO:/work" \
    -w /work \
    "$IMAGE" \
    bash -c 'mount -t tracefs nodev /sys/kernel/tracing 2>/dev/null || true; mount -t debugfs nodev /sys/kernel/debug 2>/dev/null || true; exec "$0" "$@"' "${@:-bash}"
