// error: cannot compare `ipv6` with `mac`
//
// Addresses compare with addresses of the same kind, or a literal of that
// kind. An IPv6 address and a MAC are never the same thing.

event E { a: u8 }

probe xdp("lo") {
    let src = pkt.ipv6(22);
    let smac = pkt.mac(6);
    if src == smac {
        emit E { a: 1 };
    }
}
