// error: `byte_at(64)` is outside `str<64>`
//
// Reading one past the end of a stack buffer is the classic bug the
// verifier catches as "invalid stack off". Here the index is a constant so
// honey can check it exactly.

event E { b: u8 }

probe tracepoint("syscalls", "sys_enter_openat") {
    let path: str<64> = read_user_str(arg(1));
    emit E { b: path.byte_at(64) };
}
